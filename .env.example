# Copy this file to .env.local when working on your computer, and add the same
# names under Settings > Environment Variables in Vercel for the live website.
# Never commit real values.

# --- Admin panel login (required) -------------------------------------------
# Username and password for /admin. You can change them later inside the panel.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-password

# At least 32 random characters. Used to sign the login cookie.
ADMIN_SESSION_SECRET=replace-with-32-or-more-random-characters

# --- Saving changes on the live website (required on Vercel) ------------------
# Vercel > your project > Storage > Upstash Redis (free). Connecting it adds
# these two values for you automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
