# Copy this file to .env.local when working on your computer, and add the same
# names under Settings > Environment Variables in Vercel for the live website.
# Never commit real values.

# --- Admin panel login (required) -------------------------------------------
# Username and password for /admin. You can change them later inside the panel.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-password

# At least 32 random characters. Used to sign the login cookie.
ADMIN_SESSION_SECRET=replace-with-32-or-more-random-characters

# --- Saving changes on the live website (required on Vercel) ------------------
# Vercel > your project > Storage > Upstash Redis (free). Connecting it adds
# these two values for you automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email notifications (optional, recommended) -------------------------------
# When someone sends the Contact form or a job application, an email goes to the
# team. Job applications go to the HR email and contact messages to the main email
# set in the admin panel (Site-wide > Contact details). The resume is attached.
# Use any mailbox that supports SMTP (Gmail app password, Zoho, Outlook, your host).
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Shown as the sender. Leave empty to use SMTP_USER.
MAIL_FROM=
# Optional: send every notification to this address instead.
MAIL_TO=

# --- Google reCAPTCHA on the Contact and Careers forms (recommended) -------------
# Create a "reCAPTCHA v2 - I'm not a robot" key at https://www.google.com/recaptcha/admin
# and add your domain. Without these two values the check is simply not shown.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- AI assistant (the chat button at the bottom right) -----------------------------
# Paste your API key. The service is picked from the key: Anthropic (sk-ant-...), OpenAI (sk-...),
# Google Gemini (AIza...), Groq (gsk_...) or OpenRouter (sk-or-...). Without a key the chat still
# answers contact details and the basics from the website, and sends everything else to the Contact form.
AI_API_KEY=
# Optional: AI_PROVIDER (anthropic, openai, gemini, groq, openrouter), AI_MODEL and AI_BASE_URL.
# Optional: most AI calls per minute for the whole site, so the AI service never returns "429 too many requests".
AI_MAX_PER_MINUTE=12
